# Solo entorno local. Copiar a .env y reemplazar ambos valores.
POSTGRES_PASSWORD=replaceWithLocalAlphanumericPassword
DEMO_PASSWORD=replaceWithDemoPasswordAtLeast12Chars
DATABASE_URL=postgres://demo:replaceWithLocalAlphanumericPassword@localhost:5432/trazabilidad
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Puerto publicado por Compose. Usar 3002 si la demo nativa ocupa 3000.
APP_PORT=3000
ALLOW_DEMO_SEED=true
# Activar solo con una base de pruebas dedicada, nunca la base operativa:
TEST_ALLOW_DB_WRITE=false
