  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "ProducerInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "ParcelInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "producerId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "producerId",
          "name",
          "latitude",
          "longitude"
        ]
      },
      "PreLotInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parcelId": {
            "type": "string",
            "format": "uuid"
          },
          "harvestedAt": {
            "type": "string",
            "format": "date-time",
          "description": "Fecha/hora ISO 8601 con zona, no posterior a la hora del servidor; se normaliza a UTC."
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,8})(?:\\.[0-9]{1,3})?$",
            "description": "Positiva, máximo técnico 999999999.999; respuesta normalizada a tres decimales."
          },
          "unit": {
            "type": "string",
            "enum": [
              "kg",
              "unidad"
            ]
          }
        },
        "required": [
          "parcelId",
          "harvestedAt",
          "quantity",
          "unit"
        ]
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "collector",
              "viewer"
            ]
          }
        },
        "required": [
          "id",
          "organizationId",
          "email",
          "role"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Producer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ]
      },
      "Parcel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "producerId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "producerId",
          "name",
          "latitude",
          "longitude",
          "createdAt"
        ]
      },
      "PreLot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "harvestId": {
            "type": "string",
            "format": "uuid"
          },
          "parcelId": {
            "type": "string",
            "format": "uuid"
          },
          "harvestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]{0,8})\\.[0-9]{3}$",
            "description": "Positiva, máximo técnico 999999999.999; respuesta normalizada a tres decimales."
          },
          "unit": {
            "type": "string",
            "enum": [
              "kg",
              "unidad"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "registrado"
            ]
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "harvestId",
          "parcelId",
          "harvestedAt",
          "quantity",
          "unit",
          "status",
          "createdBy",
          "createdAt"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrfToken": {
            "type": "string",
            "description": "Enviar como X-CSRF-Token en escrituras."
          }
        },
        "required": [
          "user",
          "csrfToken"
        ]
      }
    }
  }
