{
  "name": "trazabilidad-primer-recorrido",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "verify:compose": "node --env-file-if-exists=.env scripts/verify-compose.js",
    "test:compose": "node --env-file-if-exists=.env scripts/test-compose.js",
    "start": "node --env-file-if-exists=.env server/main.js",
    "dev": "node --env-file-if-exists=.env server/main.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/integration/*.test.js",
    "build": "vite build",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "check": "node scripts/check.js",
    "format": "prettier --write server web scripts tests *.js *.json .github/workflows/ci.yml compose*.yaml",
    "format:check": "prettier --check server web scripts tests *.js *.json .github/workflows/ci.yml compose*.yaml"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.4",
    "cookie-parser": "1.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@playwright/test": "1.65.0",
    "@electric-sql/pglite": "0.5.16",
    "prettier": "3.10.0",
    "@apidevtools/swagger-parser": "13.1.0",
    "yaml": "2.9.1"
  }
}
